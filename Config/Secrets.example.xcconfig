// Copy this file to Config/Secrets.xcconfig (git ignores it) and fill it in.
// No quotes. xcconfig treats // as a comment, so a value cannot contain it.

GEMINI_API_KEY = your-gemini-key
ELEVENLABS_API_KEY = your-elevenlabs-key

// Tiger Data: from your service's connection string, everything after postgres:// (leave the // out).
// For example: tsdbadmin:PASSWORD@abc123.tsdb.cloud.timescale.com:34567/tsdb?sslmode=require
TIGER_SERVICE = your-tiger-service

// Your Apple team ID (Xcode > Settings > Accounts, or developer.apple.com > Membership).
// Needed to run GraspPhone on an iPhone. On the Mac it also stops the camera
// permission prompt from coming back after every rebuild.
// DEVELOPMENT_TEAM = ABCDE12345
// CODE_SIGN_IDENTITY[sdk=macosx*] = Apple Development
